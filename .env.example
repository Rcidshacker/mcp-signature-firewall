# Copy to .env (gitignored) and fill in. Load with: uv run --env-file .env sigfw ...
# Never commit real keys. Before every push: git grep -nE "nvapi-[A-Za-z0-9_-]{20,}"  (expect no output, rc=1)

# --- NVIDIA build.nvidia.com (OpenAI-compatible; development endpoint) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Nebius Token Factory (final runs; separate key) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=

# --- Which endpoint the code uses: nvidia | nebius ---
LLM_ENDPOINT=nvidia
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
