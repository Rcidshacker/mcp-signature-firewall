# Copy to .env (gitignored) and fill in. Load with: uv run --env-file .env sigfw ...
# Never commit real keys. Before every push: git grep -nE "nvapi-[A-Za-z0-9_-]{20,}"  (expect no output, rc=1)

# --- NVIDIA build.nvidia.com (OpenAI-compatible; development endpoint) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Nebius Token Factory (final runs; separate key) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=

# --- Which endpoint the code uses: nvidia | nebius ---
LLM_ENDPOINT=nvidia
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Extra request options as a JSON object. Lightning "thinks" first unless this switches thinking off
# (observed 2026-10-04 on build.nvidia.com: 5 tokens/0.6 s with it, 64+ tokens cut off mid-thought without it).
LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'
# Requests per minute, shared by all worker threads. build.nvidia answers 429 above its limit (seen 2026-10-06 at
# about 100 requests a minute, with 4 workers). 0 or unset means unpaced. Use 30 for evaluation runs.
LLM_MAX_RPM=30
